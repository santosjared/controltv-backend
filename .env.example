HOST=0.0.0.0
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_SECONDS=28800
REFRESH_TOKEN_EXPIRES_SECONDS=2592000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=tvcontrol

# Solo para desarrollo local. En producción se recomienda usar migraciones.
DB_SYNCHRONIZE=true

# Directorio persistente de archivos; limpieza diaria 00:00 America/La_Paz
CONTENT_UPLOAD_DIR=uploads/contenidos

# Espera para iniciar contenido/playlists, incluyendo descarga (15 minutos).
PLAYBACK_DOWNLOAD_TIMEOUT_MS=900000
