# Generar una copia privada con: node docker/setup.mjs
COMPOSE_PROJECT_NAME=tvcontrol
FRONTEND_CONTEXT=../controltv
WEB_PORT=3001
BACKEND_PORT=3000

DB_DATABASE=tvcontrol
DB_USERNAME=tvcontrol
DB_PASSWORD=GENERATE_WITH_SETUP
JWT_SECRET=GENERATE_WITH_SETUP

# Esquema automático para esta instalación local nueva, en su propio PostgreSQL.
DB_SYNCHRONIZE=true
JWT_EXPIRES_SECONDS=28800
REFRESH_TOKEN_EXPIRES_SECONDS=2592000
PLAYBACK_DOWNLOAD_TIMEOUT_MS=900000

BOOTSTRAP_NAME=Administrador
BOOTSTRAP_CI=ADMIN-LOCAL-001
BOOTSTRAP_USER=admin
BOOTSTRAP_PASSWORD=GENERATE_WITH_SETUP

# false permite HTTP en la red local; usar true al publicar con HTTPS.
AUTH_COOKIE_SECURE=false
